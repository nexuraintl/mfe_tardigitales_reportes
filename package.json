{
  "name": "mfe-tardigitales-reportes",
  "version": "1.0.0",
  "scripts": {
    "ng": "npx ng",
    "start": "npx ng serve --host 0.0.0.0 --port 4301",
    "build": "npx ng build",
    "build:mfe": "npx ng build && node build-mfe.js",
    "watch": "npx ng build --watch --configuration development",
    "docker:build": "docker build -t mfe-tardigitales-reportes .",
    "docker:run": "docker run -p 4301:80 mfe-tardigitales-reportes",
    "docker:compose": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:rebuild": "docker-compose up -d --build"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/elements": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "typescript": "~6.0.2"
  }
}
